# Local MySQL app database (never use the integration-test schema here)
DB_HOST=localhost
DB_PORT=3306
DB_USER=YOUR_MYSQL_APP_USER
DB_PASSWORD=
DB_NAME=quan_ly_kho

# JWT: REQUIRED. Generate a long random secret for your local environment.
# An empty value intentionally prevents backend startup until configured.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Gemini: REQUIRED for the existing Gemini endpoints.
GEMINI_API_KEY=
# Multi-Agent Gemini service can read this; backend/gemini_service.py has its own model constant.
GEMINI_MODEL=gemini-3.5-flash-lite

# Vector DB: leave CHROMA_PATH unset to use the source-relative default
# defined in multi_agent/multi_agent/services/vector_service.py.
# A relative CHROMA_PATH changes meaning depending on the working directory.
# CHROMA_PATH=C:/absolute/path/to/chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Do not commit the filled backend/.env or expose it in logs/screenshots.
